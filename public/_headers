# CERO25 — cabeceras de despliegue (Cloudflare las aplica automáticamente)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# fotos e iconos: inmutables, caché larga (el navegador no vuelve a pedirlas)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# el service worker debe revalidarse siempre (lección aprendida)
/sw.js
  Cache-Control: no-cache

# CSS y JS: caché corta con revalidación
/styles.css
  Cache-Control: public, max-age=300, must-revalidate

# el panel no debe indexarse
/admin/*
  X-Robots-Tag: noindex, nofollow
